# ── VPS Docker (shared host: loopback ports, existing Caddy) ────────────────
# POSTGRES_USER=bismillah
# POSTGRES_PASSWORD=   # generate; never reuse another app's password
# POSTGRES_DB=bismillah
# WEB_HOST_PORT=18100
# ADMIN_HOST_PORT=18101
# API_HOST_PORT=18102
# NEXT_PUBLIC_STORE_URL=https://bismillahletherbd.com
# Import: SOURCE_DIRECT_URL='…direct…' pnpm vps:import-db
# Then: pnpm vps:up    (see infra/README.md). Do not bind :80/:443.

# ── Database (Prisma Postgres or local Postgres) ─────────────────────────────
# Prisma Postgres Console → Connect → copy both strings:
#   DATABASE_URL = pooled (app runtime)
#   DIRECT_URL   = direct (migrate / studio / seed)
#
# Local Docker (pnpm db:up): both can be the same localhost URL.
# Vercel: paste the same values into Project → Settings → Environment Variables
# (Production + Preview). Prisma generate during deploy needs DATABASE_URL or DIRECT_URL.

DATABASE_URL=postgresql://bismillah:bismillah@localhost:5432/bismillah
DIRECT_URL=postgresql://bismillah:bismillah@localhost:5432/bismillah

# Optional alias for pooled runtime (defaults to DATABASE_URL in getPrisma)
DATABASE_POOL_URL=postgresql://bismillah:bismillah@localhost:5432/bismillah

# ── Public URLs (browser) ────────────────────────────────────────────────────
# On Vercel multi-service: storefront /, admin /admin, API /api.
# Leave NEXT_PUBLIC_STORE_URL empty when admin and the shop share one domain.
# Set it only if the shop is on a different origin (no trailing slash).
NEXT_PUBLIC_API_URL=/api
# NEXT_PUBLIC_STORE_URL=https://your-shop.example

# ── SEO / ads (or paste in Admin → Settings) ────────────────────────────────
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# NEXT_PUBLIC_FB_PIXEL_ID=
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Server-side: web/admin → api uses Vercel binding API_INTERNAL_URL (set by vercel.json).
# Do not set API_INTERNAL_URL yourself on Vercel.

# ── Redis (later — not required for Prisma DB / storefront showcase) ─────────
REDIS_CACHE_URL=redis://localhost:6379
REDIS_CORE_URL=redis://localhost:6380

# ── Secrets ──────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=owner@bismillah.local
SEED_ADMIN_PASSWORD=dev-only-change-me
# Required only to create new admins at /admin/register (12+ chars). Not used for login.
ADMIN_MASTER_KEY=replace-with-admin-master-key-12plus
# HMAC-signed admin + customer session cookies (jose HS256). 16+ chars.
SESSION_SECRET=replace-with-a-long-random-string

# ── Couriers ─────────────────────────────────────────────────────────────────
# Steadfast merchant panel → API keys. There is no sandbox; a live key books a real parcel.
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
# Shown on the printed Steadfast-style label (merchant panel → Merchant ID).
STEADFAST_MERCHANT_ID=
# Pathao merchant API. Live merchant login needs PATHAO_MODE=live (or PATHAO_BASE_URL).
COURIER_PROVIDER=pathao
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_MODE=live

# ── EPS (checkout online pay: bKash, Nagad, cards) ───────────────────────────
# Prefer Admin → Settings → EPS. Env values fill any blank saved field.
# EPS_ENABLED=false
# EPS_MODE=live
# EPS_USERNAME=
# EPS_PASSWORD=
# EPS_HASH_KEY=
# EPS_MERCHANT_ID=
# EPS_STORE_ID=

# ── SSLCommerz (legacy; storefront uses EPS) ─────────────────────────────────
# Sandbox store: https://developer.sslcommerz.com/registration/
# Live store: https://signup.sslcommerz.com/register
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_MODE=sandbox

# ── Cloudflare R2 (product photos) ───────────────────────────────────────────
# R2 → Manage R2 API tokens, plus the bucket's public r2.dev or custom domain.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://pub-example.r2.dev
ENCRYPTION_KEY=replace-with-a-32-byte-key
REVALIDATE_SECRET=replace-with-a-long-random-string

# Auth notes:
# - Admin login: http://localhost:3000/admin (email + password). Run `pnpm dev` + `pnpm dev:admin`.
# - Admin register: /admin/register (needs ADMIN_MASTER_KEY). Owner/manager can also invite from Team.
# - Seed staff: SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD after pnpm db:seed.
# - Customer (/account): phone session (COD-friendly).
