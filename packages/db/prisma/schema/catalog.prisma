model Category {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  parent         Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[] @relation("CategoryTree")
  name           String
  slug           String
  /// Materialized path, unique, used in `/category/<path>`. Example: `wallets/long-wallet`.
  path           String    @unique
  sortOrder      Int       @default(0) @map("sort_order")
  imageKey       String?   @map("image_key")
  isActive       Boolean   @default(true) @map("is_active")
  seoTitle       String?   @map("seo_title")
  seoDescription String?   @map("seo_description") @db.Text
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  primaryProducts Product[]         @relation("PrimaryCategory")
  productLinks    ProductCategory[]
  couponLinks     CouponCategory[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id                String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name              String
  slug              String        @unique
  description       String        @default("") @db.Text
  status            ProductStatus @default(draft)
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz(6)
  scheduledFor      DateTime?     @map("scheduled_for") @db.Timestamptz(6)
  primaryCategoryId String        @map("primary_category_id") @db.Uuid
  primaryCategory   Category      @relation("PrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  seoTitle          String?       @map("seo_title")
  seoDescription    String?       @map("seo_description") @db.Text
  ogImageKey        String?       @map("og_image_key")
  isFeatured        Boolean       @default(false) @map("is_featured")
  /// Maintained by a Postgres trigger. Do not write this from the app.
  searchVector      Unsupported("tsvector")? @map("search_vector")
  /// Denormalized. Updated from the outbox, never on the read path.
  ratingAvg         Decimal       @default(0) @map("rating_avg") @db.Decimal(4, 2)
  ratingCount       Int           @default(0) @map("rating_count")
  soldCount         Int           @default(0) @map("sold_count")
  version           Int           @default(0)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  categories     ProductCategory[]
  options        ProductOption[]
  variants       ProductVariant[]
  media          ProductMedia[]
  attributes     ProductAttribute[]
  reviews        Review[]
  wishlists      Wishlist[]
  couponProducts CouponProduct[]

  @@index([primaryCategoryId, status, publishedAt(sort: Desc), id])
  @@index([status, publishedAt(sort: Desc), id])
  @@index([isFeatured, status])
  @@map("products")
}

model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductOption {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int     @default(0) @map("sort_order")

  values ProductOptionValue[]

  @@unique([productId, name])
  @@index([productId])
  @@map("product_options")
}

model ProductOptionValue {
  id        String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  optionId  String        @map("option_id") @db.Uuid
  option    ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value     String
  sortOrder Int           @default(0) @map("sort_order")

  variants VariantOptionValue[]

  @@unique([optionId, value])
  @@index([optionId])
  @@map("product_option_values")
}

model ProductVariant {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String    @unique
  /// Selling price in paisa.
  price        BigInt
  salePrice    BigInt?   @map("sale_price")
  saleStartsAt DateTime? @map("sale_starts_at") @db.Timestamptz(6)
  saleEndsAt   DateTime? @map("sale_ends_at") @db.Timestamptz(6)
  /// Internal. Never sent to the storefront.
  costPrice    BigInt?   @map("cost_price")
  stockOnHand  Int       @default(0) @map("stock_on_hand")
  stockReserved Int      @default(0) @map("stock_reserved")
  weightG      Int       @default(0) @map("weight_g")
  isActive     Boolean   @default(true) @map("is_active")
  version      Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  optionValues VariantOptionValue[]
  media        ProductMedia[]
  movements    InventoryMovement[]
  reservations StockReservation[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([productId, isActive])
  @@map("product_variants")
}

model VariantOptionValue {
  variantId     String             @map("variant_id") @db.Uuid
  optionValueId String             @map("option_value_id") @db.Uuid
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Restrict)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("variant_option_values")
}

model ProductMedia {
  id                String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId         String                 @map("product_id") @db.Uuid
  product           Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?                @map("variant_id") @db.Uuid
  variant           ProductVariant?        @relation(fields: [variantId], references: [id], onDelete: SetNull)
  type              MediaType
  storageKey        String                 @map("storage_key")
  /// Width label → object key, for AVIF / WebP / JPEG.
  variants          Json                   @default("{}")
  width             Int?
  height            Int?
  blurPlaceholder   String?                @map("blur_placeholder")
  sortOrder         Int                    @default(0) @map("sort_order")
  alt               String                 @default("")
  processingStatus  MediaProcessingStatus  @default(pending) @map("processing_status")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([productId, sortOrder])
  @@index([variantId])
  @@index([processingStatus])
  @@map("product_media")
}

model Attribute {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  slug      String @unique
  sortOrder Int    @default(0) @map("sort_order")

  values AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  attributeId String    @map("attribute_id") @db.Uuid
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  slug        String
  sortOrder   Int       @default(0) @map("sort_order")

  products ProductAttribute[]

  @@unique([attributeId, slug])
  @@index([attributeId])
  @@map("attribute_values")
}

model ProductAttribute {
  productId        String         @map("product_id") @db.Uuid
  attributeValueId String         @map("attribute_value_id") @db.Uuid
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([productId, attributeValueId])
  @@index([attributeValueId])
  @@map("product_attributes")
}
