{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && corepack enable && pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && pnpm --filter @bismillah/web build",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_INTERNAL_URL"
        }
      ]
    },
    "admin": {
      "root": "apps/admin",
      "framework": "nextjs",
      "installCommand": "cd ../.. && corepack enable && pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && pnpm --filter @bismillah/admin build",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_INTERNAL_URL"
        }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "express",
      "installCommand": "cd ../.. && corepack enable && pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && pnpm --filter @bismillah/db generate",
      "rewrites": [
        {
          "source": "/api/:path*",
          "destination": "/:path*"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": { "service": "admin" }
    },
    {
      "source": "/admin/:path*",
      "destination": { "service": "admin" }
    },
    {
      "source": "/api/:path*",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
