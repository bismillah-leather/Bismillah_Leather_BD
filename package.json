{
  "name": "bismillah-leather",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @bismillah/web dev",
    "dev:admin": "pnpm --filter @bismillah/admin dev",
    "dev:api": "pnpm --filter @bismillah/api dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @bismillah/db generate",
    "db:migrate": "pnpm --filter @bismillah/db migrate",
    "db:seed": "pnpm --filter @bismillah/db seed",
    "db:validate": "pnpm --filter @bismillah/db validate",
    "db:studio": "pnpm --filter @bismillah/db studio",
    "vps:up": "docker compose -p bismillah-leather -f infra/docker-compose.prod.yml --env-file .env up -d --build",
    "vps:update": "bash infra/scripts/vps-update.sh",
    "vps:down": "docker compose -p bismillah-leather -f infra/docker-compose.prod.yml --env-file .env down",
    "vps:logs": "docker compose -p bismillah-leather -f infra/docker-compose.prod.yml logs -f --tail=200",
    "vps:migrate": "docker compose -p bismillah-leather -f infra/docker-compose.prod.yml --env-file .env run --rm migrate",
    "vps:import-db": "bash infra/scripts/import-database.sh"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}
