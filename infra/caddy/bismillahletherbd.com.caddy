# INCLUDE this file from the existing host Caddyfile.
# Do not replace /etc/caddy/Caddyfile.
#
# After VPS audit confirms 127.0.0.1:18100–18102 are free:
#
#   import /etc/caddy/sites/bismillahletherbd.com.caddy
#
# Routing note: the Next.js storefront owns /api/reviews, /api/account, etc.
# Sending ALL of /api to Express would 404 those routes. Express is only
# healthz/readyz, so those two paths go to the API container.
#
# Canonical host is https://bismillahleatherbd.com
# www + old typo domains 301 there. Do NOT 308 apex HTTP→HTTPS here:
# Cloudflare Flexible talks HTTP to origin; that looped before.

(bismillah_leather_proxy) {
	encode gzip zstd
	handle /api/healthz {
		reverse_proxy 172.18.0.1:18102
	}
	handle /api/readyz {
		reverse_proxy 172.18.0.1:18102
	}
	handle /admin* {
		reverse_proxy 172.18.0.1:18101
	}
	handle {
		reverse_proxy 172.18.0.1:18100
	}
}

http://bismillahleatherbd.com {
	import bismillah_leather_proxy
}

http://www.bismillahleatherbd.com, http://bismillahletherbd.com, http://www.bismillahletherbd.com {
	redir https://bismillahleatherbd.com{uri} 301
}

bismillahleatherbd.com {
	tls internal
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	import bismillah_leather_proxy
}

www.bismillahleatherbd.com, bismillahletherbd.com, www.bismillahletherbd.com {
	tls internal
	redir https://bismillahleatherbd.com{uri} 301
}
